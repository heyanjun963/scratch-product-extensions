{
  "name": {
    "zh-cn": "AiDoggy",
    "zh-tw": "AiDoggy",
    "en": "AiDoggy",
    "ko": "AiDoggy"
  },
  "description": {
    "zh-cn": "适用于 AiDoggy 四足机器狗的 Python 积木拓展包。",
    "zh-tw": "適用於 AiDoggy 四足機器狗的 Python 積木擴充套件。",
    "en": "Python block extension package for the AiDoggy quadruped robot.",
    "ko": "AiDoggy 사족 보행 로봇용 Python 블록 확장 패키지입니다."
  },
  "author": "Hiwonder",
  "license": "MIT",
  "isBoard": false,
  "id": "aidoggy",
  "platform": ["win", "mac", "web", "linux"],
  "version": "0.1.4",
  "scratchEditor": {
    "categories": [
      {"id": "entry", "name": "", "hideLabel": true, "blocks": ["start_thread", "start_run_thread"]},
      {
        "id": "board_resource",
        "name": {"en": "Onboard resources", "zh-cn": "板载资源", "zh-tw": "板載資源", "ko": "온보드 리소스"},
        "blocks": ["buzzer_tone_set", "buzzer_tone_set_arg", "get_battery_level", "set_low_battery_alarm"]
      },
      {"id": "output", "name": {"en": "Output", "zh-cn": "输出打印", "zh-tw": "輸出列印", "ko": "출력"}, "blocks": ["print_str", "print_number"]},
      {
        "id": "motion",
        "name": {"en": "Motion control", "zh-cn": "运动控制", "zh-tw": "運動控制", "ko": "동작 제어"},
        "blocks": ["set_pose", "set_move", "set_move_xyz", "set_turn", "set_gait", "set_stop"]
      },
      {
        "id": "action_group",
        "name": {"en": "Action group control", "zh-cn": "动作组控制", "zh-tw": "動作組控制", "ko": "동작 그룹 제어"},
        "blocks": ["run_action", "run_action_name", "stop_action"]
      }
    ],
    "blocks": {
      "start_thread": {
        "section": "main",
        "launcher": "Hiwonder.startMain({MAIN})"
      },
      "start_run_thread": {
        "section": "setup"
      },
      "set_turn": {
        "templateSelector": {
          "argument": "VALUE2",
          "cases": {
            "1": "aidoggy.omni_move(0,0,{VALUE1},0,0)",
            "-1": "aidoggy.omni_move(0,0,-{VALUE1},0,0)"
          }
        }
      },
      "run_action": {
        "arguments": {
          "BLOCK": {"type": "number", "defaultValue": "True"}
        }
      },
      "run_action_name": {
        "arguments": {
          "BLOCK": {"type": "number", "defaultValue": "True"}
        }
      }
    }
  },
  "asset": {
    "python": {
      "dir": "python/",
      "version": "0.1.4",
      "main": "main.ts",
      "dependencies": {},
      "files": [
        "_images/icon.svg",
        "_locales/en.json",
        "_locales/zh-cn.json",
        "_locales/zh-tw.json",
        "_locales/ko.json",
        "_menus/index.json"
      ]
    }
  }
}
